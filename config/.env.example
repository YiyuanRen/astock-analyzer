# ===== 飞书 (筹建中, 拿到后填) =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== LLM API Keys (当前仅启用 MiMo + DeepSeek) =====
# 小米 MiMo (Token Plan, key 以 tp- 开头)
MIMO_API_KEY=
# DeepSeek (key 以 sk- 开头)
DEEPSEEK_API_KEY=

# ----- 以下 provider 代码保留但暂未启用, 需要时再填 -----
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=

# ===== 默认模型 (可被飞书 M 指令热切换覆盖) =====
DEFAULT_LLM_PROVIDER=mimo
DEFAULT_LLM_MODEL=mimo-v2.6-flash

# ===== 告警 (可选, 异常推送到自己的飞书) =====
ALERT_FEISHU_WEBHOOK=
